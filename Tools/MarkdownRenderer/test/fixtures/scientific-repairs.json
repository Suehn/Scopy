{
  "comment": "Synthetic inputs for the scientific-profile source repairs. `expected` was produced by the former Swift implementation (MarkdownHTMLRenderer.preprocess with the scientificMarkdown policy for `inline`, the latexDocumentLike policy for `document`); the JS port must reproduce it byte for byte.",
  "cases": [
    {
      "name": "document: newline forms are unified",
      "level": "document",
      "source": "\\section{Alpha}\r\nline one\rline two line three line four",
      "expected": "# Alpha\nline one\nline two\nline three\nline four"
    },
    {
      "name": "document: sectioning commands become headings",
      "level": "document",
      "source": "\\section{Intro}\n\\section*{Starred}\n\\subsection{Sub}\n\\subsubsection*{Deep}\n  \\paragraph{Para}\n\\subparagraph*{Sub para}\n\\section{}\n\\section{Open",
      "expected": "# Intro\n# Starred\n## Sub\n### Deep\n#### Para\n##### Sub para\n\\section{}\n\\section{Open"
    },
    {
      "name": "document: labels are dropped outside code",
      "level": "document",
      "source": "\\label{sec:intro}\nText \\label{eq:1} continues \\label{a{b}c} here.\n`\\label{kept}`\nInline `\\label{code}` and \\label{gone} mixed.",
      "expected": "Text  continues  here.\n`\\label{kept}`\nInline `\\label{code}` and  mixed."
    },
    {
      "name": "document: quote and center environments",
      "level": "document",
      "source": "\\begin{quote}\nQuoted line\n\n\\section{Inside}\n\\end{quote}\n\\begin{center}\nCentered\n\\end{center}\n\\begin{quote}[x]\nOption quote\n\\end{quote}",
      "expected": "> Quoted line\n\n> # Inside\nCentered\n> Option quote"
    },
    {
      "name": "document: tabular becomes a pipe table",
      "level": "document",
      "source": "\\begin{tabular}{|l|c|r|}\n\\hline\nName & Value & Note \\\\\n\\hline\nA & 1 & x \\\\ B & 2 \\\\\nC & 3 & y & extra \\\\\n\\hline{}\nD \\& E & 4 & z\n\\hline% trailing\n\\end{tabular}\nAfter table",
      "expected": "| Name | Value | Note |\n| --- | --- | --- |\n| A | 1 | x |\n| B | 2 |  |\n| C | 3 | y extra |\n| D \\& E | 4 | z |\nAfter table"
    },
    {
      "name": "document: starred tabular inside a quote",
      "level": "document",
      "source": "\\begin{quote}\n\\begin{tabular*}{\\textwidth}{ll}\nH1 & H2 \\\\\nv1 & v2 \\\\\n\\end{tabular*}\n\\end{quote}",
      "expected": ""
    },
    {
      "name": "document: empty tabular",
      "level": "document",
      "source": "\\begin{tabular}{l}\n\\hline\n\\end{tabular}\nnext",
      "expected": "next"
    },
    {
      "name": "document: nested itemize and enumerate",
      "level": "document",
      "source": "\\begin{itemize}\n\\item First\n  \\item[--] Dashed option\n\\begin{enumerate}\n\\item One\n\\item[(b)] Two\n\\end{enumerate}\n\\item Back\n\\end{itemize}\n\\item Orphan item\n\\end{enumerate}",
      "expected": "- First\n- Dashed option\n  1. One\n  1. Two\n- Back\n- Orphan item"
    },
    {
      "name": "document: horizontal rules",
      "level": "document",
      "source": "\\noindent\\rule{\\linewidth}{0.4pt}\n\\rule{\\textwidth}{1pt}\n\\rule{\\linewidth}{1pt} trailing\nsee \\rule{\\textwidth}{1pt}",
      "expected": "---\n---\n---\nsee \\rule{\\textwidth}{1pt}"
    },
    {
      "name": "document: fenced code is untouched",
      "level": "document",
      "source": "```latex\n\\section{Code}\n\\label{x}\n```\n~~~~\n```\n\\item still code\n```\n~~~~\n\\section{After}",
      "expected": "```latex\n\\section{Code}\n\\label{x}\n```\n~~~~\n```\n\\item still code\n```\n~~~~\n# After"
    },
    {
      "name": "document: syntax islands survive",
      "level": "document",
      "source": "\\section{[Link \\label{x}](https://example.com/\\label{y})}\n[paper]: /Users/alice/paper_v2.md \"P\"\nSee <https://example.com/a\\label{z}> and https://example.com/\\label{w} or /Users/alice/\\label{v}.md\n![img \\label{i}](./img\\label{j}.png) and [ref \\label{r}][paper] and ~/x\\label{t} ../y\\label{u}\n`code \\label{c}` ``two ` ticks \\label{d}`` file://Host/\\label{f}",
      "expected": "# [Link \\label{x}](https://example.com/\\label{y})\n[paper]: /Users/alice/paper_v2.md \"P\"\nSee <https://example.com/a\\label{z}> and https://example.com/\\label{w} or /Users/alice/\\label{v}.md\n![img \\label{i}](./img\\label{j}.png) and [ref \\label{r}][paper] and ~/x\\label{t} ../y\\label{u}\n`code \\label{c}` ``two ` ticks \\label{d}`` file://Host/\\label{f}"
    },
    {
      "name": "document: unclosed fence is one island",
      "level": "document",
      "source": "\\section{Top}\n```\n\\section{Never}\n\\label{never}",
      "expected": "# Top\n```\n\\section{Never}\n\\label{never}"
