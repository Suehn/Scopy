            "value": "未知大小"
          }
        }
      }
    },
    "Unlimited history": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限历史"
          }
        }
      }
    },
    "Unpin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消置顶"
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 %@"
          }
        }
      }
    },
    "Website icons (fetched online and cached)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站图标（联网获取并缓存）"
          }
        }
      }
    },
    "When a content type is off, Scopy does not add it to history. The current clipboard is not affected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭某类内容后，Scopy 将跳过写入历史（不会影响当前剪贴板）。"
          }
        }
      }
    },
    "When on, a Markdown or LaTeX PNG export to the clipboard is compressed with pngquant first and only the compressed PNG is copied (it enters history). On by default.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，Markdown/LaTeX 导出 PNG 到剪贴板时会先用 pngquant 压缩，并仅输出压缩后的 PNG（会进入历史）。默认开启。"
          }
        }
      }
    },
